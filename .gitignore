# Python
__pycache__/
*.py[cod]
*.so
.env
.venv/
venv/
env/
*.egg-info/
dist/
build/

# Models (keep heavy/temporary files ignored)
models/*.onnx
models/plots/
models/logs/
models/backup_*/
models/random_forest.pkl
models/artcn_best.pt
*.bak

# Explicitly track production AR-TCN model artifacts (approx ~350 KB total)
!models/artcn.pt
!models/scaler.pkl
!models/label_encoder.pkl
!models/feature_cols.pkl
!models/metrics.json

# Dataset (large CSV)
dataset/*.csv

# Local Runtime Data
backend/data/*.json
backend/data/*.db
*.db
backend/data/.jwt_secret
.jwt_secret
!backend/data/.gitkeep

# Firebase credentials (NEVER commit)
backend/firebase/serviceAccountKey.json
**/*.json.key

# Node.js
frontend/node_modules/
frontend/build/

# IDE
