# =============================================================================
# GrainGuard AI — Environment Configuration Template (.env.example)
# Copy this file to .env and configure your production values.
# DO NOT COMMIT SENSITIVE SECRETS OR REAL CREDENTIALS TO VERSION CONTROL.
# =============================================================================

# ── 1. Initial Setup Credentials (Used on First Database Initialization) ─────
# If these environment variables are provided, GrainGuard AI will initialize
# the default Admin and Viewer accounts with these exact credentials.
# If accounts already exist in the database, they will NEVER be overwritten.
GRAINGUARD_ADMIN_USER=admin
GRAINGUARD_ADMIN_PASS=YOUR_SUPPLIED_ADMIN_PASSWORD_HERE
GRAINGUARD_ADMIN_EMAIL=admin@grainguard.org

GRAINGUARD_VIEWER_USER=viewer
GRAINGUARD_VIEWER_PASS=YOUR_SUPPLIED_VIEWER_PASSWORD_HERE
GRAINGUARD_VIEWER_EMAIL=viewer@grainguard.org

# ── 2. JWT Session Security ──────────────────────────────────────────────────
# A secure random 64-hex string is automatically generated in backend/data/.jwt_secret
# if JWT_SECRET_KEY is omitted. Set explicitly in production:
# JWT_SECRET_KEY=your-32-byte-secret-key-here
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ── 3. Database Persistence ──────────────────────────────────────────────────
DATABASE_URL=sqlite:///./backend/data/grainguard.db

# ── 4. External Alert Notifications (Telegram Bot API) ───────────────────────
GRAINGUARD_TELEGRAM_ENABLED=false
GRAINGUARD_TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ_placeholder
GRAINGUARD_TELEGRAM_CHAT_ID=-100123456789_placeholder

# ── 5. External Alert Notifications (SMTP Email) ─────────────────────────────
GRAINGUARD_EMAIL_ENABLED=false
GRAINGUARD_SMTP_HOST=smtp.gmail.com
GRAINGUARD_SMTP_PORT=587
GRAINGUARD_SMTP_USER=alerts@grainguard.org
GRAINGUARD_SMTP_PASS=your_app_specific_email_password
GRAINGUARD_EMAIL_RECIPIENTS=operator@farm.com,manager@farm.com

# ── 6. Alert Policy & Cooldown Thresholds ────────────────────────────────────
GRAINGUARD_NOTIFY_MIN_RISK=High
GRAINGUARD_NOTIFY_COOLDOWN_MIN=15

# ── 7. Frontend Integration ──────────────────────────────────────────────────
REACT_APP_API_URL=http://localhost:8000
