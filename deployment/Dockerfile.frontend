# ============================================================
# FILE: deployment/Dockerfile.frontend
# Multi-stage build for the React dashboard.
# Stage 1: build with Node.js
# Stage 2: serve with Nginx
# ============================================================

# ── Stage 1: Build ────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY frontend/package.json frontend/package-lock.json* ./

# Install dependencies
RUN npm ci --silent

# Copy source
COPY frontend/ .

# Build for production
ARG REACT_APP_API_URL=http://localhost:8000
ARG REACT_APP_FIREBASE_DATABASE_URL=""
ARG REACT_APP_FIREBASE_API_KEY=""
ARG REACT_APP_FIREBASE_PROJECT_ID=""

ENV REACT_APP_API_URL=$REACT_APP_API_URL
ENV REACT_APP_FIREBASE_DATABASE_URL=$REACT_APP_FIREBASE_DATABASE_URL
ENV REACT_APP_FIREBASE_API_KEY=$REACT_APP_FIREBASE_API_KEY
ENV REACT_APP_FIREBASE_PROJECT_ID=$REACT_APP_FIREBASE_PROJECT_ID

RUN npm run build

# ── Stage 2: Serve with Nginx ─────────────────────────────
FROM nginx:1.25-alpine

# Remove default config
RUN rm /etc/nginx/conf.d/default.conf

# Add custom Nginx config (React SPA routing)
COPY deployment/nginx.conf /etc/nginx/conf.d/default.conf

# Copy built assets
COPY --from=builder /app/build /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
